#!/usr/bin/env node
// getdr for npm: runs the getdr binary from the platform package that npm
// installed next to this one (getdr-<os>-<cpu>, an optional dependency picked
// by os and cpu). Generated by tools/dist in https://github.com/index-pages/getdr.
"use strict";

const { spawnSync } = require("node:child_process");

const packages = {
{{- range .Binaries}}
  "{{.Platform}}": "{{.Path}}",
{{- end}}
};

const platform = `${process.platform} ${process.arch}`;
if (!packages[platform]) {
  console.error(`getdr: no prebuilt binary for ${platform}; see {{.Homepage}}`);
  process.exit(2);
}

let binary;
try {
  binary = require.resolve(packages[platform]);
} catch {
  const name = packages[platform].split("/")[0];
  console.error(`getdr: the package ${name} is missing; reinstall getdr with optional dependencies enabled`);
  process.exit(2);
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  console.error(`getdr: ${result.error.message}`);
  process.exit(2);
}
if (result.signal) {
  process.kill(process.pid, result.signal);
}
process.exit(result.status ?? 2);
