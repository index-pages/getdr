# Generated for each release by tools/dist in https://github.com/index-pages/getdr;
# edits here are overwritten by the next release.
class Getdr < Formula
  desc "Command-line tool to check Ahrefs Domain Rating (DR) of domains"
  homepage "{{.Homepage}}"
  version "{{.Version}}"
  license "MIT"

  on_macos do
    on_arm do
      url "{{.P.darwin_arm64.URL}}"
      sha256 "{{.P.darwin_arm64.SHA256}}"
    end
    on_intel do
      url "{{.P.darwin_amd64.URL}}"
      sha256 "{{.P.darwin_amd64.SHA256}}"
    end
  end

  on_linux do
    on_arm do
      url "{{.P.linux_arm64.URL}}"
      sha256 "{{.P.linux_arm64.SHA256}}"
    end
    on_intel do
      url "{{.P.linux_amd64.URL}}"
      sha256 "{{.P.linux_amd64.SHA256}}"
    end
  end

  def install
    bin.install "getdr"
  end

  test do
    assert_equal "getdr #{version}", shell_output("#{bin}/getdr -V").strip
  end
end
